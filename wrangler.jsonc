{
  "name": "istobarton",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only downloads go through src/worker.js (to count them and email Isto); everything else is served directly.
    "run_worker_first": ["/downloads/*", "/dl/*"]
  },
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "istobarton_downloads" }],
  // Recipient is NOTIFY_TO, set in the Cloudflare dashboard (Settings > Variables and Secrets) so no address is in this public repo.
  // keep_vars stops deploys from wiping dashboard variables. Do NOT add NOTIFY_TO to "vars" here, even if the dashboard suggests it.
  "keep_vars": true,
  "send_email": [{ "name": "MAILER" }],
  "observability": { "enabled": true }
}
