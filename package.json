{
  "name": "istobarton-site",
  "private": true,
  "description": "istobarton.com static site. No build step; these tools are for checks only.",
  "scripts": {
    "serve": "npx --yes serve -l 4173 .",
    "test": "playwright test",
    "links": "linkinator http://localhost:4173 --recurse --skip \"^(?!http://localhost)\"",
    "report": "node scripts/analytics-report.mjs",
    "resume-pdf": "node scripts/resume-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "linkinator": "6.1.2",
    "serve": "14.2.8"
  }
}
